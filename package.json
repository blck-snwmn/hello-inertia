{
  "name": "hello-inertia",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run dev:server & bun run dev:client",
    "dev:server": "bun --hot src/server.ts",
    "dev:client": "vite --host 127.0.0.1",
    "build": "bun run build:client",
    "build:client": "vite build",
    "start": "NODE_ENV=production bun src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/inertia": "^0.7.0",
    "@inertiajs/react": "^2.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "hono": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3"
  }
}
