{
  "name": "hello-inertia",
  "private": true,
  "packageManager": "bun@1.3.14",
  "type": "module",
  "scripts": {
    "dev": "bun run dev:server & bun run dev:client",
    "dev:server": "bun --hot src/server.ts",
    "dev:client": "vite --host 127.0.0.1",
    "build": "bun run build:client",
    "build:client": "vite build",
    "start": "NODE_ENV=production bun src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/inertia": "0.7.0",
    "@inertiajs/react": "3.6.1",
    "@vitejs/plugin-react": "6.0.5",
    "hono": "4.13.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "7.0.2"
  }
}
